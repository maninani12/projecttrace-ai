# Copy to .env at the project root. Never add real credentials to source control.
APP_ENV=development
# Ignored outside development/demo; false disables the published seeded demo login.
SEED_DEMO_USER=true
DATABASE_URL=sqlite:///./projecttrace.db
QUEUE_MODE=local
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=hashing-v1
VECTOR_STORE=faiss
MAX_UPLOAD_MB=50
MAX_EXTRACTED_MB=200
MAX_FILE_COUNT=10000
MAX_TEXT_FILE_MB=2
MAX_CHUNKS=20000
UPLOAD_RETENTION_HOURS=24
STORAGE_DIR=.storage
SESSION_HOURS=24
